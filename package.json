{
  "name": "rodeoviejo",
  "version": "1.0.0",
  "description": "Cliente HTTP con historial buscable en SQLite. App de escritorio (Electron).",
  "type": "module",
  "main": "main.js",
  "bin": {
    "rodeoviejo": "server.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/make-icon.mjs && electron-builder --mac",
    "dist:x64": "node scripts/make-icon.mjs && electron-builder --mac --x64",
    "dist:arm64": "node scripts/make-icon.mjs && electron-builder --mac --arm64",
    "dist:universal": "node scripts/make-icon.mjs && electron-builder --mac --universal"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rodeoviejo.app",
    "productName": "RodeoViejo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "RodeoViejo",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
